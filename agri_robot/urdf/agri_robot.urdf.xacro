<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agri_robot">

  <!--
    AGRI ROBOT — 4WD Skid-Steer Agricultural Robot
    Style: XAG P100 inspired, outdoor farm use
    ─────────────────────────────────────────────────
    Chassis : 0.80 m × 0.55 m × 0.20 m  (L × W × H)
    Wheels  : radius=0.10 m, width=0.06 m
    Track   : 0.62 m  (left-to-right wheel center)
    Wheelbase: 0.50 m (front-to-rear wheel center)
    Ground clearance: 0.05 m
    ─────────────────────────────────────────────────
    Gazebo plugin: libgazebo_ros_diff_drive.so
      → pairs front+rear wheels per side for skid-steer
    Topics published:
      /cmd_vel        (geometry_msgs/Twist)  — input
      /odom           (nav_msgs/Odometry)    — output
      /joint_states   (sensor_msgs/JointState)
      /imu/data       (sensor_msgs/Imu)
      /gps/fix        (sensor_msgs/NavSatFix)
      /camera/image_raw         (RGB)
      /camera/depth/image_raw   (Depth)
  -->

  <!-- ===================================================== -->
  <!--                     CONSTANTS                         -->
  <!-- ===================================================== -->

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="chassis_l"    value="0.80"/>
  <xacro:property name="chassis_w"    value="0.55"/>
  <xacro:property name="chassis_h"    value="0.20"/>
  <xacro:property name="chassis_mass" value="20.0"/>

  <!-- Wheels -->
  <xacro:property name="wheel_r"    value="0.10"/>
  <xacro:property name="wheel_w"    value="0.06"/>
  <xacro:property name="wheel_mass" value="1.5"/>

  <!-- Ground clearance (chassis bottom to ground) -->
  <xacro:property name="clearance" value="0.05"/>

  <!-- Derived positions -->
  <!-- chassis center height above ground = clearance + half chassis height -->
  <xacro:property name="chassis_z" value="${clearance + chassis_h/2.0}"/>   <!-- 0.15 -->
  <!-- wheel center Z relative to base_link = wheel_r - chassis_z          -->
  <xacro:property name="wheel_dz"  value="${wheel_r - chassis_z}"/>          <!-- -0.05 -->
  <!-- wheel front/rear offset from chassis center -->
  <xacro:property name="wheel_dx"  value="0.25"/>
  <!-- wheel left/right offset: chassis half-width + wheel half-width + 0.005 gap -->
  <xacro:property name="wheel_dy"  value="${chassis_w/2.0 + wheel_w/2.0 + 0.005}"/>  <!-- 0.31 -->


  <!-- ===================================================== -->
  <!--                  INERTIA MACROS                       -->
  <!-- ===================================================== -->

  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(w*w + h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(l*l + h*h)/12.0}" iyz="0.0"
        izz="${m*(l*l + w*w)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3.0*r*r + h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3.0*r*r + h*h)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>


  <!-- ===================================================== -->
  <!--                    WHEEL MACRO                        -->
  <!-- ===================================================== -->

  <xacro:macro name="wheel" params="name dx dy">
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.20 0.20 0.20 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_r}" h="${wheel_w}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <!-- rpy="-PI/2 0 0" orients cylinder so its length axis lies along Y (sideways) -->
      <origin xyz="${dx} ${dy} ${wheel_dz}" rpy="${-PI/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
  </xacro:macro>


  <!-- ===================================================== -->
  <!--                   BASE LINKS                          -->
  <!-- ===================================================== -->

  <!-- Ground-level reference frame -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- Main chassis body -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
      <material name="green">
        <color rgba="0.15 0.55 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       l="${chassis_l}" w="${chassis_w}" h="${chassis_h}"/>
  </link>


  <!-- ===================================================== -->
  <!--                      WHEELS                           -->
  <!-- ===================================================== -->

  <xacro:wheel name="front_left_wheel"  dx=" ${wheel_dx}" dy=" ${wheel_dy}"/>
  <xacro:wheel name="front_right_wheel" dx=" ${wheel_dx}" dy="-${wheel_dy}"/>
  <xacro:wheel name="rear_left_wheel"   dx="-${wheel_dx}" dy=" ${wheel_dy}"/>
  <xacro:wheel name="rear_right_wheel"  dx="-${wheel_dx}" dy="-${wheel_dy}"/>


  <!-- ===================================================== -->
  <!--                     SENSORS                           -->
  <!-- ===================================================== -->

  <!-- RGB-D Camera (front-mounted, tilted 10° downward) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.10 0.04"/></geometry>
      <material name="black"><color rgba="0.10 0.10 0.10 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.10 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <!-- Front face of chassis, 10 cm above top, tilted 10° downward -->
    <origin xyz="${chassis_l/2.0 - 0.02} 0 ${chassis_h/2.0 + 0.10}"
            rpy="0 0.175 0"/>
  </joint>

  <!-- Camera optical frame (standard ROS convention: Z forward, X right, Y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- IMU (at chassis center) -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0"
               iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- GPS antenna (top of chassis) -->
  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="white"><color rgba="0.95 0.95 0.95 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0"
               iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="0 0 ${chassis_h/2.0 + 0.03}" rpy="0 0 0"/>
  </joint>


  <!-- ===================================================== -->
  <!--              GAZEBO VISUAL MATERIALS                  -->
  <!-- ===================================================== -->

  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>


  <!-- ===================================================== -->
  <!--                  GAZEBO PLUGINS                       -->
  <!-- ===================================================== -->

  <!-- ── 4WD Skid-Steer Drive ─────────────────────────────
       Two diff_drive instances share /cmd_vel so all 4 wheels
       are independently powered (true 4WD).
       Front plugin: publishes /odom and odom TF.
       Rear  plugin: drives rear wheels only (no duplicate odom).
  ────────────────────────────────────────────────────────── -->

  <!-- Front axle (publishes odom + TF) -->
  <gazebo>
    <plugin name="drive_front" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_mux</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Rear axle (same cmd_vel, no duplicate odom) -->
  <gazebo>
    <plugin name="drive_rear" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel_mux</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Joint State Publisher ────────────────────────────
       Publishes wheel joint angles to /joint_states
       so robot_state_publisher can compute TF tree.
  ────────────────────────────────────────────────────────── -->
  <gazebo>
    <plugin name="joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=/joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── IMU Sensor ────────────────────────────────────────
       Publishes to /imu/data (sensor_msgs/Imu)
       Used by robot_localization EKF in Phase 2.
  ────────────────────────────────────────────────────────── -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <remapping>~/out:=/imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── GPS Sensor ────────────────────────────────────────
       Publishes to /gps/fix (sensor_msgs/NavSatFix)
       Uses world spherical_coordinates from empty_field.sdf.
       Used by navsat_transform_node in Phase 2.
  ────────────────────────────────────────────────────────── -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.5</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>3.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </gps>
      <plugin filename="libgazebo_ros_gps_sensor.so" name="gps_plugin">
        <ros>
          <remapping>~/out:=/gps/fix</remapping>
        </ros>
        <frame_name>gps_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── RGB Camera ───────────────────────────────────────
       libgazebo_ros_camera.so publishes:
         /camera/image_raw      (sensor_msgs/Image, RGB)
         /camera/camera_info    (sensor_msgs/CameraInfo)
  ────────────────────────────────────────────────────────── -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="rgb_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="rgb_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
          <remapping>camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── Depth Camera (Phase 4) ───────────────────────────
       Same camera_link, type="depth".
       libgazebo_ros_camera.so handles depth in Gazebo Classic 11.
       Publishes depth image as 32FC1 (metres).
         /camera/depth/image_raw   (sensor_msgs/Image, 32FC1)
         /camera/depth/camera_info (sensor_msgs/CameraInfo)
       Consumed by yolo_obstacle_node for 3-D obstacle localisation.
  ────────────────────────────────────────────────────────── -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/depth/image_raw</remapping>
          <remapping>camera_info:=/camera/depth/camera_info</remapping>
        </ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
